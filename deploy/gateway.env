# MOSS Seed Vault (gateway) settings. install-gateway.sh copies this to /etc/moss/gateway.env;
# edit that copy, then: sudo systemctl restart moss-gateway

# The radio. Use the stable /dev/serial/by-id/... name, not /dev/ttyACM0,
# which can change between reboots. List them with: ls -l /dev/serial/by-id/
MOSS_PORT=/dev/ttyACM0

# No channel setting: MOSS finds (or creates) the #moss channel on the radio by
# itself. (An old MOSS_CHANNEL line here is harmless and ignored.)

# The Wikipedia library, on the USB stick labelled KIWIX. The service waits
# up to two minutes for it to appear after boot.
MOSS_ZIM=/media/moss/KIWIX/wikipedia_en_all_nopic_2026-06.zim

# Anything else to pass to `python -m moss gateway`. Articles go out in full by
# default; e.g. --max-bytes 12000 shortens long ones to save airtime.
# --pad-sizes rounds encrypted pages up to standard sizes so their length says
# less about what was read (about 10% more airtime; off unless added here).
# --scope NAME keeps MOSS's flooded traffic inside a MeshCore region (ask your
# local mesh which region name their repeaters use; needs firmware 1.12+).
# --gap 0.5 sends spores faster than the default 1 second apart (see README:
# "Making it faster").
MOSS_EXTRA=
